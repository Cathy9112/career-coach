APP_ENV=production
COOKIE_SECURE=true
CORS_ORIGINS=https://your-domain.example
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CHROMA_HOST=chroma
CHROMA_PORT=8000
SESSION_TTL_SECONDS=86400
SESSION_LOCK_TIMEOUT_SECONDS=300
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
LLM_RATE_LIMIT=10
LLM_RATE_WINDOW_SECONDS=60
DAILY_LLM_REQUEST_QUOTA=100
KNOWLEDGE_RETENTION_DAYS=90
USAGE_RETENTION_DAYS=180
RETENTION_CLEANUP_INTERVAL_SECONDS=86400
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
MYSQL_DATABASE=career_coach
MYSQL_USER=career_user
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=60
KNOWLEDGE_COLLECTION_NAME=interview_knowledge_base_dashscope_v1
EMBEDDING_DIMENSIONS=1024
PYTHON_IMAGE=m.daocloud.io/docker.io/library/python:3.12-slim
MYSQL_IMAGE=m.daocloud.io/docker.io/library/mysql:8.4
REDIS_IMAGE=m.daocloud.io/docker.io/library/redis:7-alpine
CHROMA_IMAGE=m.daocloud.io/docker.io/chromadb/chroma:1.5.9
NGINX_IMAGE=m.daocloud.io/docker.io/library/nginx:1.27-alpine
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TIMEOUT=120
